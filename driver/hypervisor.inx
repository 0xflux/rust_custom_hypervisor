;===================================================================
; Sample WDM Driver
; Copyright (c) Microsoft Corporation
;===================================================================

[Version]
Signature   = "$WINDOWS NT$"
Class       = hypervisor
ClassGuid   = {097c541a-b76d-4713-b95c-610f4dde4104}
Provider    = %ProviderString%
PnpLockDown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskId1%,,,""

[SourceDisksFiles]
hypervisor.sys = 1

; ================= Class section =====================

[ClassInstall32]
Addreg=HyperVisorClassReg

[HyperVisorClassReg]
HKR,,,0,%ClassName%
HKR,,Icon,,-5

; ================= Install section =================

[Manufacturer]
%StdMfg%=Standard,NT$ARCH$.10.0...16299

[Standard.NT$ARCH$.10.0...16299]
%DeviceDesc%=HyperVisorDMDevice, root\SAMPLE_WDM_HW_ID

[HyperVisorDMDevice.NT$ARCH$]
CopyFiles=Drivers_Dir

[Drivers_Dir]
hypervisor.sys

; ================= Service installation =================
[HyperVisorDMDevice.NT$ARCH$.Services]
AddService = SampleWDMService, %SPSVCINST_ASSOCSERVICE%, HyperVisor_WDM_Service_Install

[HyperVisor_WDM_Service_Install]
DisplayName    = %ServiceDesc%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START 
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\hypervisor.sys

; ================= Strings =================
[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ProviderString         = "FluxSec"
StdMfg                 = "(Standard system devices)"
DiskId1                = "HyperVisor Installation Disk #1"
DeviceDesc             = "HyperVisor Device"
ServiceDesc            = "HyperVisor Service"
ClassName              = "hypervisor"